fz_hud_colors:
    ld a,(fz_bar)
    or a
    ret z
    ld a,(_title_mode)
    or a
    ret nz
    ld a,(_player_count)
    cp 2
    jr nc,h16_count
    ld a,255
h16_count:
    inc a
    ld c,a
    ld de,h16_two
    cp 3
    jr z,h16_start
    ld de,h16_compact
h16_start:
    ld hl,0x5ae1
    ld b,30
h16_loop:
    ld a,(de)
    inc de
    cp c
    jr nc,h16_black
    or a
    jr z,h16_black
    push hl
    push de
    dec a
    ld l,a
    ld h,0
    ld de,_player_attrs
    add hl,de
    ld a,(hl)
    and 7
    pop de
    pop hl
    jr h16_combine
h16_black:
    xor a
h16_combine:
    push bc
    ld c,a
    ld a,(_zx_bar_attr)
    and 0xf8
    or c
    pop bc
    cp (hl)
    jr z,h16_next
    ld (hl),a
h16_next:
    inc hl
    djnz h16_loop
    ret
